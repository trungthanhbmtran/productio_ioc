{
  "name": "@productioc/grpc-protos", 
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "gen:grpc": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src --ts_proto_opt=outputServices=grpc-js,env=node,esModuleInterop=true ./proto/*.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "google-protobuf": "^3.21.0"
  },
  "devDependencies": {
    "ts-proto": "^1.150.0",
    "typescript": "^5.0.0"
  }
}