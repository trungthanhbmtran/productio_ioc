# Dockerfile.backend
FROM node:18-alpine AS base

# --- 1. Prune ---
FROM base AS pruner
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install turbo --global
COPY . .
ARG APP_NAME
# Prune giữ lại code của service (ví dụ: services/auth-service)
RUN turbo prune --scope=${APP_NAME} --docker

# --- 2. Install & Build (Dev Deps) ---
FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN corepack enable
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
COPY turbo.json turbo.json

ARG APP_NAME
# Build NestJS -> tạo ra thư mục dist
RUN pnpm turbo build --filter=${APP_NAME}

# --- 3. Install Prod Deps (Tối ưu size) ---
FROM base AS prod-deps
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN corepack enable
# Chỉ cài gói cần thiết để chạy
RUN pnpm install --prod --frozen-lockfile

# --- 4. Runner ---
FROM base AS runner
WORKDIR /app
ENV NODE_ENV production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nestjs

ARG APP_NAME

# Copy node_modules (chỉ prod)
COPY --from=prod-deps --chown=nestjs:nodejs /app/node_modules ./node_modules

# Copy code đã build (dist) từ thư mục services/
COPY --from=builder --chown=nestjs:nodejs /app/services/${APP_NAME}/dist ./dist

# Copy file package.json (nếu cần script start)
COPY --from=builder --chown=nestjs:nodejs /app/services/${APP_NAME}/package.json ./package.json

USER nestjs
EXPOSE 3000

# Chạy file main.js trong thư mục dist
CMD ["node", "dist/main.js"]